{
    "framework": "vite",
    "proxy": {
        "entrypoint": "proxy.js",
        "matcher": ["/admin", "/admin/:path*"]
    },
    "headers": [
        {
            "source": "/admin/:path*",
            "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }, { "key": "Cache-Control", "value": "private, no-store" }]
        },
        {
            "source": "/acceso",
            "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
        }
    ],
    "rewrites": [
        {
            "source": "/project/:slug",
            "destination": "/api/project-seo?slug=:slug"
        },
        {
            "source": "/es/:path(diseno-web-empresas|rediseno-web-empresas|precio-pagina-web|presupuesto-web)",
            "destination": "/api/page-seo?path=es/:path"
        },
        {
            "source": "/es/web-para-bodas",
            "destination": "/api/page-seo?path=es/web-para-bodas"
        },
        {
            "source": "/ca/webs-per-a-casaments",
            "destination": "/api/page-seo?path=ca/webs-per-a-casaments"
        },
        {
            "source": "/en/wedding-websites",
            "destination": "/api/page-seo?path=en/wedding-websites"
        },
        {
            "source": "/ca/:path(disseny-web-empreses|preu-pagina-web|pressupost-web)",
            "destination": "/api/page-seo?path=ca/:path"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
