# Optional for a single-owner CRM; required if crm_settings has multiple owners.
CRM_OWNER_ID=

# Optional locally. Required for notification and confirmation emails.
RESEND_API_KEY=
LEADS_FROM_EMAIL="Portfolio <leads@alexcasanova.tech>"
LEADS_NOTIFICATION_EMAIL=hola@alexcasanova.tech
