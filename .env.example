VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only values. Never prefix these with VITE_.
# SUPABASE_URL is optional when it is the same as VITE_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional for a single-owner CRM; required if crm_settings has multiple owners.
CRM_OWNER_ID=

# SMTP is server-only. Put actual credentials in .env.local (ignored by Git) and Vercel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: defaults to SMTP_USER. Must be authorized by the SMTP provider.
LEADS_FROM_EMAIL=
LEADS_NOTIFICATION_EMAIL=hola@alexcasanova.es
